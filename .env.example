# Postgres connection string (Neon). Separate databases for dev and prod.
DATABASE_URI=
# Long random string used by Payload to sign auth tokens.
PAYLOAD_SECRET=
# Read-write tokens of *Public* Vercel Blob stores (vercel_blob_rw_<store-id>_...).
# Local dev: set BLOB_DEV_READ_WRITE_TOKEN (dev store); it takes precedence.
# Vercel: set only BLOB_READ_WRITE_TOKEN (prod store). Never set the DEV one on Vercel.
# No token at all = Media stored on local disk (media/).
BLOB_DEV_READ_WRITE_TOKEN=
BLOB_READ_WRITE_TOKEN=
# Public site origin, no trailing slash (e.g. http://localhost:3000 in dev).
# Used for Payload serverURL and absolute sitemap URLs.
NEXT_PUBLIC_SERVER_URL=
